# Base URL of the FastAPI backend, e.g. http://localhost:8000/api/v1
VITE_API_URL=

# When true, modules serve their local dev fixtures instead of calling
# VITE_API_URL. Flip to false once the corresponding FastAPI endpoints exist.
# Auth is not covered by this flag: sign-in always goes through Clerk, and
# /auth/me and /auth/register-tenant always go to the backend.
VITE_USE_MOCKS=true

# Clerk instance the portal authenticates against (pk_test_... / pk_live_...).
# The backend must list this app's origin in CLERK_AUTHORIZED_PARTIES.
VITE_CLERK_PUBLISHABLE_KEY=
