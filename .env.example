# Base URL of the FastAPI backend, e.g. http://localhost:8000/api/v1
VITE_API_URL=

# Clerk instance the portal authenticates against (pk_test_... / pk_live_...).
# The backend must list this app's origin in CLERK_AUTHORIZED_PARTIES.
VITE_CLERK_PUBLISHABLE_KEY=

# Root domain of the marketplace, which serves each company at <subdomain>.<domain>. Vehicle and
# renter payment links are built on it; unset, they point at veltrio.io.
VITE_CUSTOMER_PORTAL_DOMAIN=veltrio.autos

# Google Maps key with the Places API (New) enabled, used by the location address picker.
# Restrict it by HTTP referrer and to the Places API — it ships in the client bundle.
# Leave blank to fall back to a plain address text field.
VITE_GOOGLE_MAPS_API_KEY=

# Where the Billing tab's Enterprise plan sends a company asking for a quote.
# Leave blank to show the plan without a contact button.
VITE_SALES_EMAIL=

# Veltrio's public Terms of Service and Privacy Policy. Once both are set, sign-in and sign-up
# say that continuing accepts them; until then they say nothing rather than link to no page.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Set to true once the API serves POST /verifications/{id}/insurance-link. Until then the send
# dialog offers Copy link only, rather than Send email / Send text buttons that would fail.
VITE_INSURANCE_LINK_DELIVERY=false

# Sentry project the portal reports errors to (Project Settings > Client Keys). Public by design:
# it ships in the client bundle. Leave blank to send nothing, as in development.
VITE_SENTRY_DSN=
# Names the deployment in Sentry, e.g. production or staging. Defaults to the build mode.
VITE_SENTRY_ENVIRONMENT=

# Build-time only, and only where the site is deployed: uploads source maps so Sentry's stack
# traces name real files and lines. The token is a secret; never give it a VITE_ prefix.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
