# Base URL of the FastAPI backend, e.g. http://localhost:8000/api/v1
VITE_API_URL=

# Serves local fixtures instead of calling VITE_API_URL. The vehicles module ignores this and
# always calls the real API; it still gates auth and the modules whose endpoints do not exist
# yet (bookings, customers, payments, pricing, locations, dashboard).
VITE_USE_MOCKS=true

# Clerk instance the portal authenticates against (pk_test_... / pk_live_...).
# The backend must list this app's origin in CLERK_AUTHORIZED_PARTIES.
VITE_CLERK_PUBLISHABLE_KEY=
